# Copy this file to .env and fill in your own values (never commit .env).

# Spotify app credentials, from https://developer.spotify.com/dashboard
# Create an app there, add "http://127.0.0.1:8888/callback" as a Redirect URI.
SPOTIFY_CLIENT_ID=

# Only needed if you ever change the default.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional overrides
# CLASSIFY_MODEL=claude-sonnet-5
# PLAYLIST_PREFIX=Vibe:
